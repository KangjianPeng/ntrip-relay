[Unit]
Description=NTRIP RTCM relay over serial
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ntrip-relay
Group=ntrip-relay
SupplementaryGroups=dialout
WorkingDirectory=/opt/ntrip-relay
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ntrip-relay/.venv/bin/python -u /opt/ntrip-relay/ntrip_relay.py --env-file /opt/ntrip-relay/.env
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=5
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=multi-user.target
