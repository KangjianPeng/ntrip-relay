  <version>0.1.0</version>
  <description>Forward NTRIP RTCM corrections and publish GNSS PVT solutions to ROS 2.</description>
  <maintainer email="pkjinfinity@outlook.com">Kangjian Peng</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
